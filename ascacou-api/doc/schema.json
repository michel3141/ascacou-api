        {
            "name": "GameResource",
            "type": "games",
            "graphql_entrypoint": "games",
            "description": "Partie d'un salon. POST /games { room_id } lance la partie suivante. Chaque PATCH modifie un seul attribut, qui désigne l'action (voir chaque attribut). Les champs calculés (board, legal_moves…) sont en lecture seule.",
            "attributes": {
                "id": {
                    "type": "integer_id",
                    "readable": true,
                    "writable": true,
                    "description": null
                },
                "room_id": {
                    "type": "integer",
                    "readable": false,
                    "writable": "guarded",
                    "description": "Code du salon, pour lancer la partie suivante (la précédente doit être terminée)."
                },
                "number": {
                    "type": "integer",
                    "readable": true,
                    "writable": false,
                    "description": "Rang de la partie dans le salon (1, 2, …)."
                },
                "status": {
                    "type": "string_enum",
                    "readable": true,
                    "writable": false,
                    "description": "drafting (pioche), playing ou finished."
                },
                "host_hand": {
                    "type": "array_of_integers",
                    "readable": true,
                    "writable": false,
                    "description": "Cartes-motifs (0 à 15) de l'hôte."
                },
                "guest_hand": {
                    "type": "array_of_integers",
                    "readable": true,
                    "writable": false,
                    "description": "Cartes-motifs (0 à 15) de l'invité."
                },
                "first_player_id": {
                    "type": "integer",
                    "readable": true,
                    "writable": "guarded",
                    "description": "Joueur qui commence. PATCH avec l'id de l'adversaire : laisser la main (avant le 1er coup) ; en pioche, avec son propre id : laisser piocher l'adversaire en premier (avant la 1re carte)."
                },
                "opening_color": {
                    "type": "string",
                    "readable": true,
                    "writable": "guarded",
                    "description": "Pion imposé : couleur du premier pion, choisie par le second joueur (black ou white)."
                },
                "takeback_requested": {
                    "type": "boolean",
                    "readable": true,
                    "writable": "guarded",
                    "description": "Demande d'annulation en cours. true : demander (après avoir joué) ; false : refuser (adversaire). Accepter : DELETE /moves/:id."
                },
                "result": {
                    "type": "string",
                    "readable": true,
                    "writable": "guarded",
                    "description": "host, guest ou draw. PATCH avec le rôle de l'adversaire : abandonner ; avec son propre rôle : réclamer la victoire (adversaire absent depuis 2 minutes)."
                },
                "end_reason": {
                    "type": "string",
                    "readable": true,
                    "writable": false,
                    "description": "score, resign (abandon) ou claim (victoire réclamée)."
                },
                "lock_version": {
                    "type": "integer",
                    "readable": true,
                    "writable": "guarded",
                    "description": "Version de la partie. À renvoyer avec une modification : si elle est dépassée, 409."
                },
                "board": {
                    "type": "string",
                    "readable": true,
                    "writable": false,
                    "description": "Plateau, rangées séparées par / : b noir, w blanc, . vide (\"b..../...../..w../...../.....\")."
                },
                "current_player_id": {
                    "type": "integer",
                    "readable": true,
                    "writable": false,
                    "description": "Joueur qui doit agir : piocher, choisir la couleur d'ouverture ou jouer."
                },
                "awaiting_opening_color": {
                    "type": "boolean",
                    "readable": true,
                    "writable": false,
                    "description": "Pion imposé : le second joueur doit choisir la couleur du premier pion."
                },
                "required_color": {
                    "type": "string",
                    "readable": true,
                    "writable": false,
                    "description": "Couleur imposée au prochain coup, ou null si le choix est libre."
                },
                "score": {
                    "type": "hash",
                    "readable": true,
                    "writable": false,
                    "description": "Motifs reproduits de chaque jeu : { host, guest }."
                },
                "realized_squares": {
                    "type": "array",
                    "readable": true,
                    "writable": false,
                    "description": "Carrés complets du plateau : [{ pattern, coord }], coord = case en haut à gauche ; une carte est reproduite si sa valeur y figure."
                },
                "last_move": {
                    "type": "hash",
                    "readable": true,
                    "writable": false,
                    "description": "Dernier pion posé : { coord, color, rank }, ou null avant le premier coup."
                },
                "blocked_coords": {
                    "type": "array_of_strings",
                    "readable": true,
                    "writable": false,
                    "description": "Cases où aucune couleur n'est jouable (« pions verts »)."
                },
                "legal_moves": {
                    "type": "hash",
                    "readable": true,
                    "writable": false,
                    "description": "Cases jouables et couleurs permises : { \"1x1\": [\"black\", \"white\"], … }."
                }
            },
